{
  "name": "tokenshooter",
  "version": "1.0.0",
  "private": true,
  "description": "A Jev-like System One model in your browser: a small language model plays a first-person shooter on your GPU, one token per move.",
  "keywords": [
    "jev",
    "jev-like",
    "system-one",
    "webgpu",
    "llm",
    "small-language-model",
    "transformers-js",
    "qwen",
    "threejs",
    "game-ai",
    "in-browser"
  ],
  "homepage": "https://github.com/YV17labs/TokenShooter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YV17labs/TokenShooter.git"
  },
  "license": "MIT",
  "author": "Yoann Vanitou",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "simulate": "node scripts/simulate.js"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@huggingface/transformers": "4.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
